# Copie para .env (cp .env.example .env) e escolha UMA opção de modelo. O .env nunca vai para o Git.

# ===== Opção A: tudo local e grátis (Ollama) =====
ANVIL_PROVIDER=ollama
ANVIL_FAST_PROVIDER=ollama
ANVIL_MODEL=qwen2.5-coder:7b
ANVIL_FAST_MODEL=qwen2.5-coder:7b

# ===== Opção B: API da Anthropic (comente a opção A e descomente aqui) =====
# ANTHROPIC_API_KEY=
# ANVIL_PROVIDER=anthropic
# ANVIL_FAST_PROVIDER=anthropic
# ANVIL_MODEL=claude-haiku-5-5
# ANVIL_FAST_MODEL=claude-haiku-5-5
# ANVIL_MAX_USD=0.5          # trava de custo por run do modo agente (US$)

# ===== Opção C: outro provedor do LangChain (ex.: OpenAI) =====
# pip install langchain-openai
# OPENAI_API_KEY=
# ANVIL_PROVIDER=openai
# ANVIL_FAST_PROVIDER=openai
# ANVIL_MODEL=<modelo>
# ANVIL_FAST_MODEL=<modelo>
# ANVIL_PRICE=entrada,saida  # US$ por milhão de tokens, para o custo aparecer certo

# ===== Chat de dúvidas sobre o Blender (RAG) =====
# Por padrão usa o modelo "rápido" acima. Para usar outro só no chat:
# ANVIL_RAG_PROVIDER=ollama
# ANVIL_RAG_MODEL=qwen2.5-coder:7b
ANVIL_EMBED_MODEL=nomic-embed-text   # embeddings locais (ollama pull nomic-embed-text); sem Ollama a busca usa só BM25
ANVIL_CHAT_MCP=on                    # conferir nomes da API no Blender aberto (off se não usar o Blender)

# ===== Ollama =====
ANVIL_OLLAMA_URL=http://localhost:11434
ANVIL_NUM_CTX=8192                   # contexto do modelo local (8192 cabe numa GPU de 6 GB)

# ===== Modelagem no Blender =====
ANVIL_JUDGE=off
ANVIL_IMAGE_BACKEND=none
ANVIL_MAX_ITERS=3
ANVIL_RENDER_RES=768
ANVIL_STYLE=realista
ANVIL_ALVO=jogo                      # jogo (orçamento de tempo real) ou completo (render)
ANVIL_PERFIL=auto                    # modo agente: auto, forte (escreve bpy) ou fraco (ferramentas prontas)
